# ── Supabase ─────────────────────────────────────────────────────────────────
# Local dev: run `npx supabase start` and copy the printed values.
# Production: copy from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to the browser / never prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
