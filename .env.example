# ── Supabase ─────────────────────────────────────────────────────────────────
# Local dev: run `npx supabase start` and copy the printed values.
# Production: copy from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to the browser / never prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments ─────────────────────────────────────────────────────────────────
# Provider: "simulated" (default, instant paid — Fase 1) | "midtrans" | "xendit".
# For a real provider, set its keys below and point the provider's webhook at
# POST {NEXT_PUBLIC_SITE_URL}/api/payments/webhook
PAYMENT_PROVIDER=simulated

# Midtrans (Snap)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit (Invoice)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
